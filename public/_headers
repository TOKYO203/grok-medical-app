# En-têtes servis par le CDN (Cloudflare Pages et Netlify lisent tous deux ce
# fichier depuis la racine du dossier publié ; Vercel l'ignore et reçoit les
# mêmes règles via `routeRules` dans vite.config.ts).
#
# Les fiches de nosographie sont des ACTIFS STATIQUES immuables : contenu
# médical versionné, servi à la demande, jamais compilé dans le bundle.
# 1 an + immutable = un seul téléchargement par fiche et par navigateur.
# ⚠️ Pour corriger une fiche déjà publiée, purger le cache du CDN (le nom du
# fichier ne change pas) — procédure dans docs/performance.md.
/content/pathologies/*
  Cache-Control: public, max-age=31536000, immutable

# Signes & Syndromes : même régime. Une catégorie = un actif JSON immuable
# (`public/content/signes/<catégorie>.json`), téléchargé à la demande ; le
# manifeste `_index.json` est volontairement dans ce dossier aussi, il est donc
# cache un an comme le reste (il n'est relu qu'après purge du CDN).
/content/signes/*
  Cache-Control: public, max-age=31536000, immutable

# Manifeste PWA et service worker : jamais figés dans un cache immuable.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
