{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17",
    "lru-cache": "^11.5.3"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run postbuild:budget && npm run postbuild:cloud && npm run postbuild:assets && npm run db:migrate && npm run postbuild:smoke",
    "build:netlify": "node scripts/with-app-env.mjs vite build && npm run postbuild:budget && npm run postbuild:cloud && npm run postbuild:assets && npm run db:migrate && npm run postbuild:smoke",
    "postbuild:budget": "node scripts/performance-budget.mjs",
    "postbuild:assets": "node scripts/copy-pglite-assets.mjs",
    "postbuild:smoke": "node scripts/smoke-built-server.mjs && node scripts/survey-security-built-smoke.mjs",
    "qa:mobile": "node scripts/mobile-ui-smoke.mjs",
    "qa:mobile:built": "node scripts/qa-built-mobile.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:prove-staging": "node scripts/run-staging-migration.mjs",
    "db:validate-staging": "node scripts/validate-staging-db.mjs",
    "license:issue": "node scripts/issue-activation-key.mjs",
    "license:keys": "node scripts/generate-license-signing-keys.mjs",
    "deck:sign": "node scripts/sign-deck.mjs",
    "deck:encrypt": "node scripts/encrypt-deck.mjs",
    "deck:keys": "node scripts/generate-deck-signing-keys.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "routes:generate": "node scripts/generate-routes.mjs",
    "images:optimize": "node scripts/optimize-images.mjs --write",
    "typecheck": "tsc --noEmit",
    "release:check": "npm run routes:generate && npm test && npm run typecheck && npm run lint && npm run build",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/content/imported-deck-integrity.test.ts src/content/license-receipt.test.ts src/content/purchase-order.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/supabase-identity.server.test.ts src/lib/auscultation/phonocardiogram.test.ts src/lib/auscultation/catalog.test.ts src/lib/ecg/deformation.test.ts src/lib/ecg/analyzeEcg.test.ts src/lib/ecg/waveform.test.ts src/lib/ecg/ecg-fiches.test.ts src/lib/cloud/subscription.test.ts src/lib/checkout/messages.test.ts src/server/supabase-env.server.test.ts src/lib/analytics/events.test.ts src/lib/imported-deck-storage.test.ts src/lib/library/specialty-label.test.ts src/lib/library/deck-series.test.ts src/lib/optimus-sync-model.test.ts src/state/persist-migrations.test.ts src/i18n/messages.test.ts src/i18n/detect.test.ts src/i18n/format.test.ts src/lib/units.test.ts src/server/jwt.test.ts src/server/replay-guard.test.ts src/server/license-verify.test.ts src/content/international.test.ts src/server/lemonsqueezy/signature.test.ts src/server/lemonsqueezy/webhook.test.ts src/server/lemonsqueezy/checkout.server.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:cloudflare": "node scripts/with-app-env.mjs vite build && npm run postbuild:cloud",
    "secret:scan": "node scripts/secret-scan.mjs",
    "payment:readiness": "node scripts/payment-readiness.mjs",
    "postbuild:cloud": "node scripts/assert-supabase-build.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "~1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "jose": "6.2.12",
    "kysely": "^0.29.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jimp": "^1.6.1",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.63.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
