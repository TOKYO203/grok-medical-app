  "questions": [
    {
      "id": "sca-l3-1",
      "prompt": "Définition de l'angor stable ?",
      "choices": [
        "Douleur de repos au décours d'un effort",
        "Douleur d'effort constant, cédant au repos/trinitrine en <15 min",
        "Douleur >20 min avec troponine normale",
        "Douleur uniquement nocturne"
      ],
      "correct": 1,
      "explanation": "Angor stable : angor d'effort reproductible, seuil stable, cède en <15 min.",
      "sources": [
        {
          "title": "ESC 2023 CCS",
          "citation": "2023 ESC Guidelines on chronic coronary syndromes.",
          "organization": "ESC",
          "year": 2023
        }
      ],
      "difficulty": "base",
      "competency": "semiology"
    },
    {
      "id": "sca-l3-2",
      "prompt": "Ce qui distingue angor instable de angor stable ?",
      "choices": [
        "Durée >30 min",
        "Effort moindre, repos, ou intensité/fréquence accrues récentes (<1 mois)",
        "Troponine élevée",
        "Irradiation bilatérale"
      ],
      "correct": 1,
      "explanation": "Angor instable : modification récente (<1 mois) du pattern. Troponine normale à ce stade.",
      "sources": [
        {
          "title": "ESC 2023 ACS",
          "citation": "2023 ESC Guidelines for ACS.",
          "organization": "ESC",
          "year": 2023
        }
      ],
      "difficulty": "intermediate",
      "competency": "semiology"
    },
    {
      "id": "sca-l3-3",
      "prompt": "Critère différenciant angor instable de NSTEMI ?",
      "choices": [
        "Âge",
        "Troponine ultrasensible",
        "ECG",
        "PA"
      ],
      "correct": 1,
      "explanation": "Seule la troponine hs distingue : normale = angor instable ; élevée avec cinétique = NSTEMI.",
      "sources": [
        {
          "title": "ESC 2023 ACS",
          "citation": "2023 ESC Guidelines for ACS.",
          "organization": "ESC",
          "year": 2023
        }
      ],
      "difficulty": "intermediate",
      "competency": "diagnostic_orientation"
    },
    {
      "id": "sca-l3-4",
      "prompt": "Patiente 62 ans, angor d'effort progressif depuis 3 semaines. Diagnostic ?",
      "choices": [
        "Angor stable",
        "Angor instable",
        "SCA ST+",
        "Péricardite"
      ],
      "correct": 1,
      "explanation": "Angor crescendo : hospitalisation USIC + coronarographie rapide.",
