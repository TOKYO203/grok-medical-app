# Grok Medical App - Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs réelles

# === API Grok (xAI) ===
GROK_API_KEY=your_grok_api_key_here
GROK_API_URL=https://api.x.ai/v1

# === Base de données ===
DATABASE_URL=postgresql://user:password@localhost:5432/grok_medical

# === Auth ===
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# === Serveur ===
PORT=3000
NODE_ENV=development

# === Assistant IA : secrets uniquement côté serveur ===
# Définir au moins une clé dans l'environnement du serveur, sans préfixe VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# Secret stable requis en production pour les quotas partagés en base.
RATE_LIMIT_SALT=
