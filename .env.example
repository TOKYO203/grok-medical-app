# Optimus — variables d'environnement (modèle)
#
# Copier vers `.env.local` (dev) ou renseigner dans la plateforme d'hébergement
# (production). Ne JAMAIS commiter de valeur réelle : `.env*` est ignoré par git.
#
# ⚠️ `RATE_LIMIT_SALT` est OBLIGATOIRE en production. Sans lui, le limiteur
# partagé (`server/lib/rate-limit.ts`) refuse de démarrer volontairement et
# `/api/licenses/activate` comme `/api/licenses/status` répondent 503 (fail
# closed) — l'activation de licence est alors indisponible.
# Liste de contrôle complète : docs/production-runbook.md

# ─── Base de données (production) ───
# Postgres managé. Sans elle l'app retombe sur PGLite (preview uniquement).
DATABASE_URL=postgresql://user:password@host:5432/optimus

# ─── Authentification (Better Auth) ───
# `VITE_AUTH_ENABLED=false` (défaut livré) désactive la connexion : toutes les
# données per-utilisateur passent alors par le profil local de l'appareil.
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=https://votre-domaine.example
BETTER_AUTH_SECRET=changez-moi-secret-de-session
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=

# ─── Administration ───
# Mot de passe unique du back-office /admin (comparaison à temps constant,
# throttlée). Un back-office sans mot de passe défini refuse tout le monde.
ADMIN_PASSWORD=changez-moi-mot-de-passe-admin
# Identifiants Better Auth autorisés sur les mutations éditoriales / commandes.
CONTENT_EDITOR_USER_IDS=
PURCHASE_ADMIN_USER_IDS=

# ─── Quotas & anti-abus ───
# Obligatoire en production : pseudonymise les sujets de quota avant stockage.
RATE_LIMIT_SALT=changez-moi-sel-aleatoire
# Sel des réponses de sondage (anonymisation).
RESPONSE_SALT=
# `true` uniquement derrière un proxy qui ÉCRASE `x-forwarded-for`. Sinon un
# client peut forger l'en-tête et s'offrir un quota illimité.
TRUST_PROXY_HEADERS=

# ─── Signatures licences & decks (Ed25519, base64) ───
# La clé privée reste serveur ; la publique est inlinée dans le bundle client.
LICENSE_SIGNING_PRIVATE_KEY=
VITE_LICENSE_SIGNING_PUBLIC_KEY=
DECK_SIGNING_PRIVATE_KEY=
VITE_DECK_SIGNING_PUBLIC_KEY=

# ─── Assistant IA (server-only, jamais préfixé VITE_) ───
# Ces clés sont facturées au propriétaire : ne les exposez jamais au navigateur.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
GROQ_API_KEY=

# ─── Paiement Mobile Money ───
MOBILE_MONEY_PROVIDER=
MOBILE_MONEY_NUMBER=
MOBILE_MONEY_ACCOUNT_NAME=
MOBILE_MONEY_INSTRUCTIONS=

# ─── Publications éditoriales (Supabase Storage) ───
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLIC_BUCKET=

# ─── Divers ───
# Serveurs STUN séparés par des virgules (multijoueur P2P).
VITE_STUN_URLS=
VITE_PUBLIC_HOSTNAME=
# Développement uniquement : accepte un certificat TLS auto-signé par la base.
PSQL_INSECURE_TLS=

# ─── Sécurité Premium S1 (contenu protégé) ───
# Le contenu des 133 fiches (nosographie + « Signes & Syndromes ») est servi
# par un garde serveur. Trois briques, trois variables :
#
# 1. `LICENSE_PUBLIC_KEY` — clé PUBLIQUE Ed25519 (base64url, 32 octets bruts ou
#    SPKI) qui vérifie les jetons de licence `OPT1.<charge>.<signature>`.
#    Sans elle, la vérification de licence répond 503 (fail closed).
#    La clé PRIVÉE correspondante vit HORS du dépôt (~/.optimus-keys/) et ne
#    sert qu'à `node scripts/issue-license-token.mjs`.
LICENSE_PUBLIC_KEY=
# 2. `LICENSE_JWT_SECRET` — secret HMAC de signature des JWT de contenu
#    (≥ 32 caractères, aléatoire : `openssl rand -base64 48`). Sans lui, tout
#    `/content/**` protégé répond 503. Ne JAMAIS préfixer en VITE_ (le préfixe
#    VITE_ est inliné dans le bundle navigateur).
LICENSE_JWT_SECRET=
# 3. Anti-replay des nonces (5 min). Optionnel : sans ces deux valeurs,
#    l'anti-replay utilise un cache mémoire par instance — suffisant en dev et
#    en mono-instance, insuffisant en multi-région. Upstash Redis (REST) est le
#    backend portable (Cloudflare Workers, Vercel, Netlify).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
